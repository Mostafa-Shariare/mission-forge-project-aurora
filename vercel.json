{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "runtime": "node",
      "entrypoint": "server.js",
      "bindings": [
        {
          "type": "service",
          "service": "game",
          "format": "url",
          "env": "GAME_SERVICE_URL"
        }
      ]
    },
    "game": {
      "root": "src/game",
      "framework": "vite",
      "installCommand": "npm install --include=dev",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    }
  },
  "rewrites": [
    {
      "source": "/game/(.*)",
      "destination": {
        "service": "game",
        "path": "/$1"
      }
    },
    {
      "source": "/game",
      "destination": {
        "service": "game",
        "path": "/"
      }
    },
    {
      "source": "/src/game/dist/(.*)",
      "destination": {
        "service": "game",
        "path": "/$1"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
